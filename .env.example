# Docker Compose: local database credentials; change together before first launch.
POSTGRES_DB=daybook
POSTGRES_USER=daybook
POSTGRES_PASSWORD=daybook_local
# For running the API outside Docker:
DATABASE_URL=postgresql+psycopg://daybook:daybook_local@localhost:5432/daybook
CORS_ORIGINS=http://localhost:5173
# Frontend uses /api through Vite's proxy. No secrets belong in VITE_* variables.
VITE_API_PROXY=http://localhost:8000


# Copy to .env. .env is private; this template can be committed.
# These example values reproduce the local Docker setup.
POSTGRES_DB=daybook
POSTGRES_USER=daybook
# Required secret: enter your own value in .env.
# Single quotes preserve literal $ and # characters: POSTGRES_PASSWORD='...'
POSTGRES_PASSWORD=

# Address and host-side ports published by Docker.
# Keep loopback for local single-user access.
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_PUBLISHED_PORT=5432
BACKEND_PUBLISHED_PORT=8001
FRONTEND_PUBLISHED_PORT=5173

# Container-network connections and listening ports.
POSTGRES_HOST=db
POSTGRES_PORT=5432
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173

# Browser origin(s), comma separated, and the frontend server's backend target.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_PROXY=http://backend:8000

# Public browser API base: use /api with the local proxy, or https://your-api/api.
# VITE_* values may be visible in the browser. Never put secrets in them.
VITE_API_BASE_URL=/api

# Optional backend connection override. Leave blank for the PostgreSQL fields above.
# On cloud platforms, inject the URL as a secret rather than committing it.
DATABASE_URL=

# Copy to .env.production, which is ignored by Git.
# These bindings are safe for a local production-mode smoke test or a host proxy.
# Put a TLS ingress/reverse proxy in front for cloud deployment.
IMAGE_TAG=production
HOST_BIND_ADDRESS=127.0.0.1
FRONTEND_PUBLISHED_PORT=8080
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000

# Required managed PostgreSQL secret. SQLAlchemy's driver must be psycopg.
# Format: postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:PORT/DB?sslmode=require
# Use the SSL mode/certificate options required by your database provider.
DATABASE_URL=

# Set to your real public frontend origin (scheme + host + optional port).
CORS_ORIGINS=http://localhost:8080

# Same-origin routing: browser -> frontend /api -> backend.
# For split public domains, use https://your-api.example/api and rebuild frontend.
VITE_API_BASE_URL=/api
# Internal server address; no /api suffix or trailing slash here.
BACKEND_UPSTREAM=http://backend:8000
# Docker's internal DNS. Use the provider's resolver for non-Compose deployments.
NGINX_RESOLVER=127.0.0.11

# Session cookies: false only for local HTTP; true for production HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300

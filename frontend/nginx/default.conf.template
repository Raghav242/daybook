server {
    listen ${FRONTEND_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # A variable plus Docker DNS allows backend containers to be recreated.
    # For separate cloud services, provide their internal HTTP(S) address.
    resolver ${NGINX_RESOLVER} valid=30s;
    set $api_upstream "${BACKEND_UPSTREAM}";
    location /api/ {
        proxy_pass $api_upstream$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # TLS terminates at the cloud ingress; do not trust arbitrary headers here.
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

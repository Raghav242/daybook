# Reference for the Render web service's environment (Render → Environment).
# Enter real values in Render only. Do not copy secrets into this file or commit them.

# Required secret: Neon POOLED connection string (host contains "-pooler").
# "postgresql://" is accepted and mapped to the psycopg driver automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Required secret: Neon DIRECT connection string (same database, host without "-pooler").
# Used only for startup migrations (advisory lock needs a real session).
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Required: the public origin, exactly as the browser shows it (no path, no trailing slash).
# The CSRF check rejects writes whose Origin is not listed. Add custom domains comma-separated.
CORS_ORIGINS=https://YOUR-SERVICE.onrender.com

# Optional (image defaults shown). Do not set SESSION_COOKIE_SECURE=false on Render.
# PORT is provided by Render (10000); FRONTEND_DIST and AUTH_IP_RATE_LIMITS=false are set by the image.
SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
AUTH_GLOBAL_SESSION_LIMIT=300
MIGRATION_LOCK_TIMEOUT_SECONDS=600
